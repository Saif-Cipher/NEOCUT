# ==============================================================================
# NeoCut Digital — Git Ignore Configuration (Strict Secrets & Media Protection)
# ==============================================================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Google Drive credentials & tokens (Server-only / Secret Manager)
credentials.json
token.json
service-account.json
*service-account*.json
client_secret*.json

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Node / Next.js local development & build outputs
node_modules/
.pnpm-store/
.next/
out/
dist/
build/
coverage/

# Python virtual environment & caches
venv/
__pycache__/
*.pyc

# Large video binaries (Exclusively hosted on Google Drive cloud database)
*.mp4
*.mov
*.avi
*.mkv
*.wmv

# Logs, OS metadata, and temporary scratch
*.log
.DS_Store
Thumbs.db

# Keep empty asset directory structures in git
!**/.gitkeep

# Private local assets & development secret folders
private-assets/
local-secrets/
