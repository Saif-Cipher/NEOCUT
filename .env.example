# ==============================================================================
# NeoCut Digital — Environment Configuration Template (.env.example)
# IMPORTANT: DO NOT PUT REAL CREDENTIALS OR SECRETS IN THIS FILE.
# This template defines the environment variable schema for development & production.
# On Vercel, set these variables in Project Settings -> Environment Variables.
# ==============================================================================

# Server-Only Google Drive Integration (NEVER prefix with NEXT_PUBLIC_)
# Used by backend server routes to resolve approved portfolio assets.
GDRIVE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your-google-oauth-client-secret-placeholder
GDRIVE_REFRESH_TOKEN=your-google-oauth-refresh-token-placeholder
GDRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id-placeholder

# Optional Service Account (Alternative to OAuth Desktop client)
# GDRIVE_SERVICE_ACCOUNT_EMAIL=neocut-service@project.iam.gserviceaccount.com
# GDRIVE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...SAFE_PLACEHOLDER...\n-----END PRIVATE KEY-----\n"

# API Security & Rate Limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100

# Public Frontend Variables (Safe to expose to client browsers)
NEXT_PUBLIC_SITE_NAME="NeoCut Digital"
NEXT_PUBLIC_SITE_URL="https://neocut.digital"
NEXT_PUBLIC_STUDIO_TAGLINE="High-Impact Video Production & Digital Storytelling"

# Deployment Environment
NODE_ENV=production
